# /etc/caddy/sites/studioln.caddy
# Pas op de VPS zetten ZODRA de DNS-records van studioln.nl en www.studioln.nl naar de VPS wijzen;
# anders probeert Caddy vergeefs een certificaat te halen. Het dashboard (dashboard.studioln.nl)
# heeft een eigen .caddy-bestand en valt hier buiten.
www.studioln.nl {
	redir https://studioln.nl{uri} permanent
}

studioln.nl {
	encode zstd gzip

	root * /var/www/studioln/site
	# Vite zet een hash in de bestandsnamen, dus die mogen een jaar in de cache
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
