{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Api": {
        "TrustedProxyNetworks": []
    },
    "Mail": {
        "ContactMessageRecipient": "contact@studioln.nl"
    },
    "RateLimit": {
        "ContactMessagePermitLimit": 5,
        "ContactMessageWindowSeconds": 3600
    },
    "Brevo": {
        "BaseUrl": "https://api.brevo.com",
        "SenderName": "StudioLN",
        "AttemptTimeoutSeconds": 10,
        "TotalTimeoutSeconds": 30,
        "MaxRetryAttempts": 3,
        "RetryBaseDelayMilliseconds": 1000
    }
}
